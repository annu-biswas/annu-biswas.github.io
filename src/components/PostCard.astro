---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '@/lib/settings';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;

// Shared with the cover on the post page, so the image morphs across the
// navigation instead of cross-fading with everything else.
const coverTransition = `post-cover-${post.id.replace(/[^a-zA-Z0-9-]/g, '-')}`;
---

<article class="group flex h-full flex-col bg-sand">
  <a href={`/blog/${post.id}`} class="block overflow-hidden">
    <img
      src={post.data.cover}
      alt={post.data.coverAlt}
      width="1200"
      height="800"
      loading="lazy"
      decoding="async"
      class="aspect-3/2 w-full object-cover transition-transform duration-500 group-hover:scale-105"
      style={`view-transition-name: ${coverTransition}; view-transition-class: post-cover`}
    />
  </a>
  <div class="flex flex-1 flex-col p-6">
    <p class="eyebrow text-clay">{post.data.category}</p>
    <h3 class="mt-3 text-xl leading-snug text-forest">
      <a href={`/blog/${post.id}`} class="transition-colors hover:text-clay">{post.data.title}</a>
    </h3>
    <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-muted">{post.data.description}</p>
    <p class="mt-5 pt-1 text-xs text-muted/80">
      <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
    </p>
  </div>
</article>
