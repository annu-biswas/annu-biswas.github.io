---
import type { CollectionEntry } from 'astro:content';

interface Props {
  book: CollectionEntry<'books'>;
}

const { book } = Astro.props;
---

<article class="grid gap-7 sm:grid-cols-[minmax(0,11rem)_1fr] sm:gap-9">
  <img
    src={book.data.cover}
    alt={book.data.coverAlt || `Cover of ${book.data.title}`}
    width="600"
    height="900"
    loading="lazy"
    decoding="async"
    class="aspect-2/3 w-full max-w-44 object-cover shadow-md"
  />
  <div>
    <h2 class="text-h3 text-forest">{book.data.title}</h2>
    {book.data.subtitle && <p class="mt-1 font-serif text-lg italic text-clay">{book.data.subtitle}</p>}
    <p class="mt-3 text-xs uppercase tracking-[0.14em] text-muted">
      {[book.data.publisher, book.data.year].filter(Boolean).join(' · ')}
    </p>
    <p class="mt-4 max-w-prose leading-relaxed text-ink/85">{book.data.blurb}</p>
    {book.data.isbn && <p class="mt-3 text-xs text-muted">ISBN {book.data.isbn}</p>}
    {book.data.buyLinks.length > 0 && (
      <ul class="mt-5 flex flex-wrap gap-3">
        {book.data.buyLinks.map((link) => (
          <li>
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex border border-forest/30 px-5 py-2.5 text-xs font-bold uppercase tracking-[0.16em] text-forest transition-colors hover:border-clay hover:text-clay"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</article>
