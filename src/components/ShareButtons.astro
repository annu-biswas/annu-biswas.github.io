---
import { getSite } from '@/lib/settings';

interface Props {
  title: string;
  /** Path of the page being shared, e.g. `/blog/my-post`. */
  path: string;
  summary?: string;
  class?: string;
}

const { title, path, summary, class: className } = Astro.props;
const site = await getSite();

const url = new URL(path, Astro.site).href;
const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);

const targets = [
  {
    label: 'X',
    href: `https://x.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`,
    path: 'M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z',
  },
  {
    label: 'LinkedIn',
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`,
    path: 'M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05a3.74 3.74 0 0 1 3.37-1.85c3.6 0 4.27 2.37 4.27 5.46zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13M7.12 20.45H3.56V9h3.56zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0',
  },
  {
    label: 'Facebook',
    href: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
    path: 'M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.68.24 2.68.24v2.97h-1.51c-1.49 0-1.96.93-1.96 1.89v2.25h3.33l-.53 3.49h-2.8V24C19.61 23.1 24 18.1 24 12.07',
  },
  {
    label: 'WhatsApp',
    href: `https://wa.me/?text=${encodedTitle}%20${encodedUrl}`,
    path: 'M17.47 14.38c-.3-.15-1.76-.87-2.03-.97s-.47-.15-.67.15-.77.96-.94 1.16-.35.22-.65.07a8.1 8.1 0 0 1-2.39-1.47 9 9 0 0 1-1.65-2.06c-.17-.3-.02-.46.13-.61s.3-.35.45-.52.2-.3.3-.5.05-.37-.02-.52-.67-1.61-.92-2.21c-.24-.58-.49-.5-.67-.51h-.57a1.1 1.1 0 0 0-.79.37 3.32 3.32 0 0 0-1.04 2.47 5.76 5.76 0 0 0 1.21 3.06 13.2 13.2 0 0 0 5.05 4.46c.7.3 1.26.48 1.69.62a4.07 4.07 0 0 0 1.87.12 3.05 3.05 0 0 0 2-1.41 2.48 2.48 0 0 0 .17-1.41c-.07-.12-.27-.2-.57-.35M12.04 21.8a8.14 8.14 0 0 1-4.15-1.14l-.3-.18-3.09.81.82-3.01-.19-.31a8.13 8.13 0 0 1 12.5-10.2 8.13 8.13 0 0 1-5.6 14.03M20.52 3.45A11.9 11.9 0 0 0 1.98 17.79L.29 24l6.35-1.67a11.9 11.9 0 0 0 5.69 1.45h.01a11.9 11.9 0 0 0 8.18-20.33',
  },
  {
    label: 'Email',
    href: `mailto:?subject=${encodedTitle}&body=${encodeURIComponent(`${summary ? `${summary}\n\n` : ''}${url}`)}`,
    path: 'M1.5 5.25A2.25 2.25 0 0 1 3.75 3h16.5a2.25 2.25 0 0 1 2.25 2.25v13.5A2.25 2.25 0 0 1 20.25 21H3.75a2.25 2.25 0 0 1-2.25-2.25zm2.03-.75 8.47 6.35 8.47-6.35zM21 6.75l-8.55 6.41a.75.75 0 0 1-.9 0L3 6.75v12h18z',
  },
];
---

<div class:list={['not-prose', className]} data-share data-url={url} data-title={title}>
  <h2 class="eyebrow text-muted">Share this article</h2>

  <ul class="mt-4 flex flex-wrap items-center gap-2.5">
    {targets.map((target) => (
      <li>
        <a
          href={target.href}
          target="_blank"
          rel="noopener noreferrer"
          title={`Share on ${target.label}`}
          class="inline-flex h-11 w-11 items-center justify-center border border-forest/20 text-forest transition-colors hover:border-clay hover:bg-clay hover:text-white"
        >
          <span class="sr-only">Share on {target.label}</span>
          <svg viewBox="0 0 24 24" class="h-[1.05rem] w-[1.05rem] fill-current" aria-hidden="true">
            <path d={target.path} />
          </svg>
        </a>
      </li>
    ))}

    <li>
      <button
        type="button"
        data-share-copy
        title="Copy link"
        class="inline-flex h-11 w-11 items-center justify-center border border-forest/20 text-forest transition-colors hover:border-clay hover:bg-clay hover:text-white"
      >
        <span class="sr-only">Copy link</span>
        <svg viewBox="0 0 24 24" class="h-[1.15rem] w-[1.15rem]" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9.5 14.5a3.5 3.5 0 0 0 5 0l3-3a3.54 3.54 0 0 0-5-5l-1 1" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M14.5 9.5a3.5 3.5 0 0 0-5 0l-3 3a3.54 3.54 0 0 0 5 5l1-1" />
        </svg>
      </button>
    </li>

    <!-- Revealed only where the device offers a native share sheet. -->
    <li hidden data-share-native>
      <button
        type="button"
        title={`Share via ${site.shortName}`}
        class="inline-flex h-11 items-center justify-center gap-2 border border-forest/20 px-4 text-xs font-bold uppercase tracking-[0.16em] text-forest transition-colors hover:border-clay hover:bg-clay hover:text-white"
      >
        <svg viewBox="0 0 24 24" class="h-[1.05rem] w-[1.05rem]" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 16V4m0 0L8 8m4-4 4 4M5 14v4.5A1.5 1.5 0 0 0 6.5 20h11a1.5 1.5 0 0 0 1.5-1.5V14" />
        </svg>
        More
      </button>
    </li>
  </ul>

  <p role="status" aria-live="polite" class="mt-3 h-5 text-xs text-clay" data-share-status></p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-share]').forEach((root) => {
    const url = root.dataset.url ?? window.location.href;
    const title = root.dataset.title ?? document.title;
    const status = root.querySelector<HTMLElement>('[data-share-status]');

    const announce = (message: string) => {
      if (!status) return;
      status.textContent = message;
      window.setTimeout(() => {
        if (status.textContent === message) status.textContent = '';
      }, 3000);
    };

    /**
     * The async Clipboard API needs a secure context and a focused document,
     * so fall back to a throwaway selection when it is unavailable.
     */
    const legacyCopy = () => {
      const field = document.createElement('textarea');
      field.value = url;
      field.setAttribute('readonly', '');
      field.style.cssText = 'position:fixed;top:0;left:-9999px;opacity:0';
      document.body.append(field);
      field.select();

      let copied = false;
      try {
        copied = document.execCommand('copy');
      } catch {
        copied = false;
      }

      field.remove();
      return copied;
    };

    root.querySelector<HTMLButtonElement>('[data-share-copy]')?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(url);
        announce('Link copied to clipboard.');
        return;
      } catch {
        // Fall through to the legacy path below.
      }

      announce(legacyCopy() ? 'Link copied to clipboard.' : 'Press Ctrl/Cmd + C to copy the link.');
    });

    // The native share sheet only exists on some devices, so the button that
    // opens it is rendered hidden and revealed here.
    const nativeItem = root.querySelector<HTMLElement>('[data-share-native]');
    if (nativeItem && typeof navigator.share === 'function') {
      nativeItem.hidden = false;
      nativeItem.querySelector('button')?.addEventListener('click', async () => {
        try {
          await navigator.share({ title, url });
        } catch {
          // The visitor dismissed the sheet — nothing to report.
        }
      });
    }
  });
</script>
