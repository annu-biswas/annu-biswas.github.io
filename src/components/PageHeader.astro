---
interface Props {
  title: string;
  intro?: string;
  eyebrow?: string;
}

const { title, intro, eyebrow } = Astro.props;
---

<section class="bg-forest text-sand">
  <div class="container-page py-16 md:py-20 lg:py-24">
    {eyebrow && <p class="eyebrow mb-4 text-sand/60">{eyebrow}</p>}
    <h1 class="max-w-3xl text-h2 text-clay">{title}</h1>
    {intro && <p class="mt-5 max-w-2xl text-base leading-relaxed text-sand/85 md:text-lg">{intro}</p>}
  </div>
</section>
