---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { getPageIntro, getPublished } from '@/lib/settings';

const page = await getPageIntro('publications');
const publications = (await getPublished('publications')).sort((a, b) => b.data.year - a.data.year);

// Group by year, newest first - the conventional shape for an academic list.
const byYear = [...new Set(publications.map((entry) => entry.data.year))].map((year) => ({
  year,
  items: publications.filter((entry) => entry.data.year === year),
}));
---

<BaseLayout title={page.seoTitle ?? page.title} description={page.seoDescription ?? page.intro}>
  <PageHeader title={page.title} intro={page.intro} />

  <section class="band bg-cream">
    <div class="container-page">
      {byYear.length === 0 ? (
        <p class="text-muted">No publications listed yet.</p>
      ) : (
        <div class="space-y-14">
          {byYear.map((group) => (
            <div class="grid gap-6 md:grid-cols-[6rem_1fr] md:gap-10">
              <h2 class="font-serif text-3xl leading-none text-clay md:sticky md:top-32 md:self-start">
                {group.year}
              </h2>
              <ul class="space-y-8">
                {group.items.map((entry) => (
                  <li class="border-t border-forest/15 pt-6">
                    <p class="eyebrow text-muted">{entry.data.type}</p>
                    <h3 class="mt-2 max-w-3xl text-xl leading-snug text-forest md:text-2xl">
                      {entry.data.url ? (
                        <a
                          href={entry.data.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="transition-colors hover:text-clay"
                        >
                          {entry.data.title}
                        </a>
                      ) : (
                        entry.data.title
                      )}
                    </h3>
                    <p class="mt-2 text-sm text-muted">
                      {entry.data.authors} · <em>{entry.data.venue}</em>
                    </p>
                    {entry.data.abstract && (
                      <p class="mt-3 max-w-prose text-sm leading-relaxed text-ink/80">{entry.data.abstract}</p>
                    )}
                    {entry.data.doi && (
                      <p class="mt-3 text-xs text-muted">
                        DOI:{' '}
                        <a
                          href={`https://doi.org/${entry.data.doi}`}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-clay underline underline-offset-2"
                        >
                          {entry.data.doi}
                        </a>
                      </p>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
